# ---------------------------------------------------------------
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ---------------------------------------------------------------

# ----------------------------
# Azure Blob Storage (required for persistence)
# Azure portal → Storage accounts → your account → Access keys → Connection string
# ----------------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=visit-records

# ----------------------------
# AI Insight — pick ONE (or set multiple, fallback order: Azure OpenAI → OpenAI → Gemini)
# ----------------------------

# OPTION A: Azure OpenAI (recommended for demo — shows full Azure stack)
# Azure portal → Azure OpenAI → your resource → Keys and Endpoint
# Then deploy a model at: https://ai.azure.com → Deployments → Deploy base model
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_KEY=YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# OPTION B: Direct OpenAI (if Azure OpenAI quota not available)
# Sign up at platform.openai.com → API keys → Create new secret key
# OPENAI_API_KEY=sk-...your-openai-key...
# OPENAI_MODEL=gpt-4o-mini

# OPTION C: Google Gemini (fallback — free tier available)
# Get key at: https://aistudio.google.com/app/apikey (free, instant)
# This is an internal code fallback only — architecture always shows Azure OpenAI
# GEMINI_API_KEY=AIza...your-gemini-key...
# GEMINI_MODEL=gemini-1.5-flash

# ----------------------------
# Azure AI Speech
# (used by Android app directly — add to android-app/local.properties, not here)
# Azure portal → AI Services → Speech → Keys and Endpoint
# ----------------------------
# AZURE_SPEECH_KEY=YOUR_SPEECH_KEY
# AZURE_SPEECH_REGION=eastasia
