# ---------------------------------------------------------------
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ---------------------------------------------------------------

# ----------------------------
# Azure Blob Storage (required for persistence)
# ----------------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=visit-records

# ----------------------------
# AI Insight — pick ONE option
# ----------------------------

# OPTION A: Direct OpenAI API (recommended — no approval needed, works immediately)
# Sign up at platform.openai.com → API keys → Create new secret key
OPENAI_API_KEY=sk-...your-openai-key...
OPENAI_MODEL=gpt-4o-mini

# OPTION B: Azure OpenAI (via Azure AI Foundry — no separate approval needed,
# deploy model at ai.azure.com → Models + endpoints → Deploy base model → gpt-4o-mini)
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
# AZURE_OPENAI_KEY=YOUR_AZURE_OPENAI_KEY
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini   ← use gpt-4o-mini (instant, no registration)

# ----------------------------
# Azure AI Speech
# (used by Android app directly — add to android-app/local.properties, not here)
# AZURE_SPEECH_KEY=YOUR_SPEECH_KEY
# AZURE_SPEECH_REGION=eastasia
# ----------------------------