<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══ HEADER ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="22dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_logo_circle"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="@color/colorPrimary"
                    android:textSize="26sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Swasthya Sahayak"
                    android:textColor="@color/colorWhite"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="AI Triage for ASHA Workers"
                    android:textColor="#A8C8FF"
                    android:textSize="12sp"
                    android:letterSpacing="0.03"/>
            </LinearLayout>
            <Button
                android:id="@+id/btnAskQuestion"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:text="💬"
                android:textSize="17sp"
                android:backgroundTint="#2962FF"
                android:textColor="@color/colorWhite"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"/>
            <TextView
                android:id="@+id/tvSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_offline_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="● OFFLINE"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- ═══ MAIN CONTENT ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="32dp">

            <!-- Language Selector (page-level) -->
            <LinearLayout
                android:id="@+id/langSelectorRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_elevated"
                android:elevation="1dp"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌐  Language / भाषा"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"/>

                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="160dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_voice_hint"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
            </LinearLayout>

            <!-- Patient Search -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_search_field"
                android:elevation="1dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/etPatientName"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="🔍  Search or add patient name"
                    android:textSize="14sp"
                    android:inputType="textPersonName"
                    android:background="@android:color/transparent"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextHint"/>
                <Button
                    android:id="@+id/btnSearchPatient"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:text="→"
                    android:textSize="18sp"
                    android:backgroundTint="@color/colorPrimary"
                    android:textColor="@color/colorWhite"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <!-- Recent Patients List -->
            <LinearLayout
                android:id="@+id/patientListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card_elevated"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECENT PATIENTS"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="8dp"/>
                <LinearLayout
                    android:id="@+id/patientListItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- Patient Info Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card_elevated"
                android:elevation="1dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PATIENT"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>
                <TextView
                    android:id="@+id/tvPatientId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="— new patient —"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/tvPatientBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEW"
                    android:textColor="@color/colorPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_blue"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
                <Button
                    android:id="@+id/btnBackToList"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:text="↩"
                    android:textSize="16sp"
                    android:backgroundTint="@color/colorBackground"
                    android:textColor="@color/colorPrimary"
                    android:minWidth="36dp"
                    android:padding="0dp"
                    android:stateListAnimator="@null"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- New Patient Details (age, gender, pregnancy) -->
            <LinearLayout
                android:id="@+id/cardNewPatientDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card_elevated"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PATIENT DETAILS"
                    android:textColor="@color/colorPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="14dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <EditText
                        android:id="@+id/etPatientAge"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:hint="Age (years)"
                        android:inputType="number"
                        android:textSize="14sp"
                        android:textColor="@color/colorTextPrimary"
                        android:background="@drawable/bg_voice_hint"
                        android:paddingStart="12dp"
                        android:layout_marginEnd="8dp"/>
                    <Spinner
                        android:id="@+id/spinnerGender"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_voice_hint"
                        android:paddingStart="8dp"/>
                </LinearLayout>
                <CheckBox
                    android:id="@+id/cbNewPatientPregnant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🤰  Currently pregnant"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:buttonTint="@color/colorPrimary"
                    android:layout_marginBottom="10dp"/>
                <EditText
                    android:id="@+id/etPatientVillage"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="📍 Village / गांव"
                    android:inputType="text"
                    android:textSize="14sp"
                    android:textColor="@color/colorTextPrimary"
                    android:background="@drawable/bg_voice_hint"
                    android:paddingStart="12dp"
                    android:layout_marginBottom="10dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnCancelNewPatient"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="#9E9E9E"
                        android:text="✖  CANCEL"
                        android:textColor="@color/colorWhite"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                    <Button
                        android:id="@+id/btnSaveNewPatient"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="@color/colorPrimary"
                        android:text="✓  SAVE PATIENT"
                        android:textColor="@color/colorWhite"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Patient Summary (returning) -->
            <LinearLayout
                android:id="@+id/cardPatientSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_elevated"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RETURNING PATIENT"
                    android:textColor="@color/colorPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"/>
                <TextView
                    android:id="@+id/tvPatientSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp"/>
                <TextView
                    android:id="@+id/tvLastVisit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvRiskLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- ═══ STEP 1: Voice ═══ -->
            <TextView
                android:id="@+id/tvStep1Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_step_indicator"
                android:text="  STEP 1 — SPEAK SYMPTOMS"
                android:textColor="@color/colorStepText"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_card_elevated"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">
                <Button
                    android:id="@+id/btnVoice"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_btn_voice"
                    android:text="🎙  TAP TO SPEAK"
                    android:textColor="@color/colorWhite"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:stateListAnimator="@null"/>
                <TextView
                    android:id="@+id/tvVoiceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Say symptoms or 'naya patient' to register"
                    android:textColor="@color/colorTextHint"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/bg_voice_hint"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:layout_marginStart="4dp"
                android:text="Try: &quot;बच्चे को बुखार है&quot; or &quot;naya patient add karein&quot;"
                android:textColor="@color/colorTextHint"
                android:textSize="11sp"
                android:fontFamily="serif"/>

            <!-- ═══ STEP 2: Symptoms (collapsible, built in Kotlin) ═══ -->
            <TextView
                android:id="@+id/tvStep2Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_step_indicator"
                android:text="  STEP 2 — CONFIRM SYMPTOMS"
                android:textColor="@color/colorStepText"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>
            <!-- Stigma-Safe Private Mode Button -->
            <Button
                android:id="@+id/btnStigmaSafe"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#7B1FA2"
                android:text="🔒  PRIVATE MODE — Patient taps directly"
                android:textColor="@color/colorWhite"
                android:textSize="13sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/symptomCategoriesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="vertical"/>

            <!-- Extra symptoms (not in checklist) -->
            <LinearLayout
                android:id="@+id/cardExtraSymptoms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_elevated"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 OTHER SYMPTOMS REPORTED"
                    android:textColor="@color/colorPHC"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/tvExtraSymptoms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <!-- ═══ Evaluate Button ═══ -->
            <Button
                android:id="@+id/btnEvaluate"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_btn_evaluate"
                android:text="▶  GET TRIAGE DECISION"
                android:textColor="@color/colorWhite"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:stateListAnimator="@null"/>

            <!-- ═══ Result Card ═══ -->
            <LinearLayout
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/resultHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvTriageLevel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/colorWhite"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TRIAGE"
                        android:textColor="#BBFFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/colorSurface"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="18dp">
                    <TextView
                        android:id="@+id/tvResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:lineSpacingExtra="5dp"/>
                    <ProgressBar
                        android:id="@+id/confidenceBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="14dp"
                        android:max="100"
                        android:progressTint="@color/colorPrimary"/>
                    <TextView
                        android:id="@+id/tvConfidence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvUncertain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:padding="12dp"
                        android:background="#FFF8E1"
                        android:text="⚠️ Uncertain — A nurse will review this case"
                        android:textColor="#E65100"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="📡  Syncing to cloud automatically"
                        android:textColor="@color/colorTextHint"
                        android:textSize="11sp"/>
                    <Button
                        android:id="@+id/btnTakePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#7B1FA2"
                        android:text="📸  Photo for Doctor Review"
                        android:textColor="@color/colorWhite"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"
                        android:visibility="gone"/>
                    <!-- Patient History Context -->
                    <TextView
                        android:id="@+id/tvHistoryContext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:padding="14dp"
                        android:background="#F3E5F5"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="5dp"
                        android:visibility="gone"/>
                    <Button
                        android:id="@+id/btnListenResult"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/colorPrimary"
                        android:text="🔊  सुनें / Listen"
                        android:textColor="@color/colorWhite"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnNewPatient"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_new_patient"
                android:text="+ NEW PATIENT"
                android:textColor="@color/colorPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:visibility="gone"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Triage decisions run offline · Data syncs when connected"
                android:textColor="@color/colorTextHint"
                android:textSize="11sp"
                android:gravity="center"/>

            <!-- ═══ Navigation Section ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <!-- Doctor Dashboard Button -->
                <Button
                    android:id="@+id/btnDoctorDashboard"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_dashboard"
                    android:text="🩺  DASHBOARD"
                    android:textColor="@color/colorWhite"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"/>

                <!-- Vaccination Tracker Button -->
                <Button
                    android:id="@+id/btnVaccination"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_vaccine"
                    android:text="💉  VACCINES"
                    android:textColor="@color/colorWhite"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
