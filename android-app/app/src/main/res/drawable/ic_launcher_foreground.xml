<?xml version="1.0" encoding="utf-8"?>
<!--
  Swasthya Sahayak app icon foreground.
  Medical cross inside a heart pulse silhouette.
  Designed for adaptive icon (API 26+, minSdk=26 so no PNG fallback needed).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Heart pulse / ECG line -->
    <path
        android:pathData="M10,62 L26,62 L32,48 L38,76 L44,40 L50,62 L58,62"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>

    <!-- Medical cross (vertical bar) -->
    <path
        android:pathData="M66,28 L66,80"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- Medical cross (horizontal bar) -->
    <path
        android:pathData="M40,54 L92,54"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

</vector>
